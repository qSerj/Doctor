<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsDoctor.Workbench.Views.MainWindow"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#15171B"
        Title="psdoctor — пульт наблюдателя">
  <Window.Styles>
    <!-- Шаг, на котором стоит сценарий. -->
    <Style Selector="StackPanel.current TextBlock">
      <Setter Property="Foreground" Value="#E8C35A" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.instruction">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8" ColumnDefinitions="*">

    <!-- Связь -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,2*,Auto,Auto" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Classes="caption" Text="адрес" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox Grid.Column="1" Text="{Binding Address, Mode=TwoWay}" PlaceholderText="http://192.168.56.5:8100" />
      <TextBlock Grid.Column="2" Classes="caption" Text="ключ" VerticalAlignment="Center" Margin="8,0,6,0" />
      <TextBox Grid.Column="3" Text="{Binding KeyFile, Mode=TwoWay}" PlaceholderText="файл ключа Bearer" />
      <Button Grid.Column="4" Content="Подключиться" Margin="8,0,0,0" Click="Подключиться" />
      <TextBlock Grid.Column="5" Classes="caption" Text="{Binding Version}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>

    <!-- Сценарий и быстрые кнопки -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,Auto" Margin="0,0,0,6">
      <TextBox Grid.Column="0"
               Text="{Binding ScenarioText, Mode=TwoWay}"
               AcceptsReturn="True"
               MinHeight="88"
               FontFamily="monospace"
               PlaceholderText="launch &quot;C:\lab\p1\1.psh&quot;&#10;wait title .psh 120&#10;close&#10;wait exit 60" />
      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4" Width="320">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="caption" Text="опыт" VerticalAlignment="Center" />
          <ComboBox Width="220" ItemsSource="{Binding Experiments}" SelectionChanged="ОпытВыбран" PlaceholderText="сценарий из каталога опытов">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="↻" ToolTip.Tip="перечитать каталог опытов" Click="ОбновитьОпыты" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Выполнить" IsEnabled="{Binding CanRun}" Click="Выполнить" />
          <Button Content="Отменить" IsEnabled="{Binding Connected}" Click="Отменить" />
          <Button Content="Прекратить наблюдение" IsEnabled="{Binding Connected}" Click="Прекратить" />
        </StackPanel>
        <TextBlock Classes="caption" Text="файл шоу в гостевой системе" />
        <TextBox Text="{Binding ShowPath, Mode=TwoWay}" PlaceholderText="C:\lab\p1\1.psh" />
        <WrapPanel ItemSpacing="4" LineSpacing="4">
          <Button Content="Запустить" IsEnabled="{Binding CanRun}" Click="Запустить" />
          <Button Content="Закрыть программу" IsEnabled="{Binding CanRun}" Click="ЗакрытьПрограмму" />
          <Button Content="Подключиться к ProShow" IsEnabled="{Binding CanRun}" Click="ПодключитьсяКПрограмме" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Рендер без диалогов" IsEnabled="{Binding CanRun}" Click="РендерБезДиалогов" />
          <Button Content="Рендер с Ok to All" IsEnabled="{Binding CanRun}" Click="РендерСДиалогом" />
        </StackPanel>
        <TextBlock Classes="caption" Text="каталог обмена" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBox Width="270" Text="{Binding ExchangeDirectory, Mode=TwoWay}" PlaceholderText="/home/.../Lab/exchange" />
          <Button Content="..." Click="ВыбратьКаталогОбмена" />
        </StackPanel>
        <CheckBox Content="включить сырой ETW" IsChecked="{Binding IncludeRaw, Mode=TwoWay}" />
        <Button Content="Собрать пакет" IsEnabled="{Binding CanExport}" Click="СобратьПакет" />
      </StackPanel>
    </Grid>

    <!-- Сеансы, лента, шаги и диалоги -->
    <Grid Grid.Row="2" ColumnDefinitions="200,*,320">
      <DockPanel Grid.Column="0" Margin="0,0,6,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
          <TextBlock Classes="caption" Text="сеансы" VerticalAlignment="Center" />
          <Button Content="Обновить" Click="ОбновитьСеансы" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Sessions}" SelectionChanged="СеансВыбран" Name="СписокСеансов">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Id}" FontFamily="monospace" />
                <TextBlock Classes="caption" Text="{Binding Mark}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="1" Margin="0,0,6,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
          <TextBlock Classes="caption" Text="лента фактов" VerticalAlignment="Center" />
          <TextBox Text="{Binding KindFilter, Mode=TwoWay}" Width="260" PlaceholderText="виды через запятую, пусто — все" />
          <Button Content="Применить фильтр" Click="ПрименитьФильтр" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Facts}" FontFamily="monospace">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="52,84,170,52,*">
                <TextBlock Grid.Column="0" Classes="caption" Text="{Binding Number}" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Elapsed}" />
                <TextBlock Grid.Column="2" Text="{Binding Kind}" />
                <TextBlock Grid.Column="3" Classes="caption" Text="{Binding ProcessId}" />
                <TextBlock Grid.Column="4" Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding Data}" ToolTip.Tip="{Binding Data}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,*">
        <!-- Что сказано оператору и кнопка, которой он отвечает: то, ради чего опыт ведётся из пульта. -->
        <Border Grid.Row="0" BorderBrush="#3A404A" BorderThickness="1" Padding="6" Margin="0,0,0,6">
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="инструкция оператору" />
            <TextBlock Classes="instruction" Text="{Binding Instruction}" />
            <Button Content="Сделано" IsEnabled="{Binding CanConfirm}" Click="Сделано" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Classes="caption" Text="шаги сценария" Margin="0,0,0,4" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Steps}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Classes.current="{Binding IsCurrent}">
                <TextBlock Text="{Binding Text}" FontFamily="monospace" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="caption" Text="{Binding State}" />
                  <TextBlock Classes="caption" Text="{Binding Note}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Classes="caption" Text="результаты рендера" Margin="0,6,0,4" />
        <ListBox Grid.Row="4" ItemsSource="{Binding Artifacts}" SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Classes="caption" Text="{Binding Bytes}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4" Margin="0,6,0,4">
          <TextBlock Classes="caption" Text="диалоги" VerticalAlignment="Center" />
          <Button Content="Обновить" Click="ОбновитьДиалоги" />
        </StackPanel>
        <ListBox Grid.Row="6" ItemsSource="{Binding Dialogs}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Text}" />
                <ItemsControl ItemsSource="{Binding Buttons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Margin="0,0,4,0" Click="НажатьКнопкуДиалога" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" Classes="caption" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
  </Grid>
</Window>
