<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsDoctor.App.Views.MainWindow"
        Width="410" Height="520" MinWidth="380" MinHeight="450" WindowStartupLocation="CenterScreen"
        Background="#F8FAFD" Title="Doctor для ProShow"
        Icon="/Assets/doctor-tray.png">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="10">
      <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
          <TextBlock x:Name="StatusIcon" Text="○" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="ProgramStatus" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProgramHint" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid ColumnDefinitions="46,*" ColumnSpacing="10">
          <Border Width="42" Height="42" Background="#E8F2FE" CornerRadius="5">
            <TextBlock Text="▤" Foreground="#176BC1" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="ProjectLabel" Text="Текущий проект" Classes="caption"/>
            <TextBlock x:Name="ProjectName" Text="Проект не определён" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProjectPath" Text="Выберите файл .psh вручную" Classes="caption" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ProjectResolution" Text="Разрешение: неизвестно" Classes="caption"/>
          </StackPanel>
        </Grid>
      </Border>
      <Button Content="Открыть проект…" Click="ОткрытьПроект"
              Background="#176BC1" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"/>
      <Button Content="Проверить проект" Click="ПроверитьПроект" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
      <Button x:Name="ProblemButton" Content="Решить проблему" Click="РазобратьсяСПроблемой" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
      <Border x:Name="AdviceBorder" Background="#EAF4FF" CornerRadius="7" Padding="11">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="AdviceText" Text="Совет: выберите проект и проверьте его, чтобы увидеть рекомендации." TextWrapping="Wrap" Classes="caption"/>
          <Button x:Name="ShowFindingsButton" Grid.Column="1" Content="Показать →" Click="ПоказатьРекомендации" IsVisible="False"/>
        </Grid>
      </Border>
      <TextBlock x:Name="ResultText" TextWrapping="Wrap" Classes="caption" IsVisible="False"/>
      <TextBlock Text="v 0.1" Classes="caption" HorizontalAlignment="Right" Margin="2,3,2,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
