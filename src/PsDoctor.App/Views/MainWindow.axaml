<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsDoctor.App.Views.MainWindow"
        Width="660"
        Height="550"
        CanResize="False"
        Background="#F5F7FB"
        Title="Doctor для ProShow"
        Icon="/Assets/doctor-tray.png">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Width="480" Margin="24" Spacing="14" HorizontalAlignment="Left">
    <StackPanel Spacing="3">
      <TextBlock Text="Doctor для ProShow" FontSize="24" FontWeight="Bold" Foreground="#1C2940" />
      <TextBlock Text="Помогает, когда ProShow мешают старые кэши." Classes="caption" />
    </StackPanel>

    <Border Width="480" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="8" Padding="16">
      <StackPanel Width="446" Spacing="6">
        <TextBlock x:Name="ProgramStatus" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="ProgramHint" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Width="480" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="8" Padding="16">
      <StackPanel Width="446" Spacing="9">
        <TextBlock Text="Проект" FontWeight="SemiBold" />
        <TextBlock x:Name="ProjectPath" Text="Не выбран. Будет проверен только кэш ProShow."
                   Classes="caption" TextWrapping="Wrap" />
        <Button Content="Выбрать проект…" HorizontalAlignment="Left" Click="ВыбратьПроект" />
      </StackPanel>
    </Border>

    <Button Content="Исправить типичные сбои" Click="ИсправитьСбои"
            Background="#176BC1" Foreground="White" FontWeight="SemiBold" />
    <TextBlock Width="480" Text="Doctor сохранит старые кэши рядом с исходными файлами. ProShow должен быть закрыт."
               Classes="caption" TextWrapping="Wrap" />
    <TextBlock x:Name="ResultText" Width="480" TextWrapping="Wrap" Foreground="#1C2940" />
  </StackPanel>
  </ScrollViewer>
</Window>
