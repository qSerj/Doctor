<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsDoctor.App.Views.MainWindow"
        Width="420" MinWidth="380" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        Title="Doctor для ProShow"
        Icon="/Assets/doctor-tray.png">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- Состояние: цвет и значок задаёт RefreshStatus классом тона. Всё, что сообщает, живёт здесь;
           белые карточки ниже — только кнопки. -->
      <Border x:Name="Hero" Classes="hero">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Classes="halo">
              <PathIcon x:Name="StatusIcon" Data="{DynamicResource IconIdle}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock x:Name="ProgramStatus" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="ProgramHint" Classes="hint" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <!-- Проект: строка шапки, появляется, когда выбран файл. -->
          <Border x:Name="ProjectLine" Classes="heroLine" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Data="{DynamicResource IconProject}" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock x:Name="ProjectName" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="ProjectPath" Classes="hint" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProjectResolution" Classes="hint" FontSize="12.5" IsVisible="False" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Margin="16" Spacing="10">
        <!-- Действия. Класс primary получает одна карточка — следующий шаг (UpdateNextStep). -->
        <Button x:Name="FinishButton" Classes="action primary" Click="ЗакончитьНаблюдение" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="tile violet"><PathIcon Data="{DynamicResource IconStop}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="actionTitle" Text="Закончить наблюдение" />
              <TextBlock Classes="caption" Text="ProShow продолжит работать" TextWrapping="Wrap" />
            </StackPanel>
            <PathIcon Grid.Column="2" Classes="chevron" Data="{DynamicResource IconNext}" />
          </Grid>
        </Button>
        <Button x:Name="OpenButton" Classes="action" Click="ОткрытьПроект">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="tile blue"><PathIcon Data="{DynamicResource IconOpen}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="actionTitle" Text="Открыть проект…" />
              <TextBlock Classes="caption" Text="Выбрать файл и открыть его в ProShow" TextWrapping="Wrap" />
            </StackPanel>
            <PathIcon Grid.Column="2" Classes="chevron" Data="{DynamicResource IconNext}" />
          </Grid>
        </Button>
        <Button x:Name="CheckButton" Classes="action" Click="ПроверитьПроект">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="tile teal"><PathIcon Data="{DynamicResource IconCheck}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="actionTitle" Text="Проверить проект" />
              <TextBlock Classes="caption" Text="Найти тяжёлые файлы и другие помехи" TextWrapping="Wrap" />
            </StackPanel>
            <PathIcon Grid.Column="2" Classes="chevron" Data="{DynamicResource IconNext}" />
          </Grid>
        </Button>
        <Button x:Name="ProblemButton" Classes="action" Click="РазобратьсяСПроблемой">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="tile orange"><PathIcon Data="{DynamicResource IconProblem}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="actionTitle" Text="Решить проблему" />
              <TextBlock Classes="caption" Text="Тормозит, зависает или закрывается" TextWrapping="Wrap" />
            </StackPanel>
            <PathIcon Grid.Column="2" Classes="chevron" Data="{DynamicResource IconNext}" />
          </Grid>
        </Button>

        <!-- Итог проверки: появляется после неё. -->
        <Border x:Name="AdviceBorder" Classes="banner" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <PathIcon x:Name="AdviceIcon" Data="{DynamicResource IconAdvice}" />
            <TextBlock x:Name="AdviceText" Grid.Column="1" Classes="body" VerticalAlignment="Center" />
            <Button x:Name="ShowFindingsButton" Grid.Column="2" Classes="primary" Content="Показать" Click="ПоказатьРекомендации"
                    IsVisible="False" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Итог последнего действия. -->
        <Border x:Name="ResultBorder" Classes="banner" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
            <PathIcon x:Name="ResultIcon" Data="{DynamicResource IconInfo}" />
            <TextBlock x:Name="ResultText" Grid.Column="1" Classes="body" />
            <ProgressBar x:Name="ResultProgress" Grid.Row="1" Grid.Column="1" IsIndeterminate="True" IsVisible="False"
                         Margin="0,8,0,0" MinHeight="4" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
