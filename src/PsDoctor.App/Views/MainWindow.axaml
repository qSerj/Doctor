<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsDoctor.App.Views.MainWindow"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="400"
        Background="#15171B"
        Title="psdoctor">
  <StackPanel Margin="16" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="psdoctor" FontSize="20" />
    <TextBlock Classes="caption" Text="Каркас Э0. Здесь будет отчёт приёмки: что в проекте поедет и одна кнопка." />
  </StackPanel>
</Window>
